op-do: {fn body
  {dict op: "call"
   args: [{dict op: "fn" args: (++ [{dict op: "list" args: []}] body)}
          {dict op: "list" args: []}]}}

bind-op-list: {fn args
  list-name: (gensym "list")
  {dict
   bind: list-name
   ops: (map-indexed args
                     {fn arg-and-i
                       arg: arg-and-i.0
                       i: arg-and-i.1
                       {qq {uq arg}: ({uq {dict op: "deref" name: list-name}} {uq {dict op: "lit" val: i}})}})}}

inc: {fn [x] (+ x 1)}

merge: {fn [d0 d1] (merge-with {fn [a b] b} d0 d1)}

as-deref: {fn [name] {dict op: "deref" name: name}}
as-lit: {fn [val] {dict op: "lit" val: val}}

genname: {fn [x] (as-deref (gensym x))}

op-or: {fn [a b]
  a-name: (genname "a")
  {qq {do
        {uq a-name}: {as-result {uq a}}
        {if {uq a-name}.ok {uq a-name}.ok {uq b}}}}}

end-index: {fn [xs] (inc {or (last-index xs) -1})}

slice: {fn [xs start end]
  (++ [] (retain xs (range start end)))}

bind-op-++: {fn [coll rest]
  arg-name: (gensym "arg")
  {dict
   bind: arg-name
   ops: [
     {qq {uq coll}: {uq (as-deref arg-name)}}
     {qq {uq rest}: (slice {uq (as-deref arg-name)}
                           {uq (as-lit (end-index coll.args))}
                           (end-index {uq (as-deref arg-name)}))}]}}

mapf: {fn {++ [inner outer] xs}
  {fn ys
    {call outer (++ [{call inner ys}] xs)}}}

map: {fn args
  (bake {call mapf args} args.0)}

[fibonacci define-fibonacci!]: (placeholder-fn)
(define-fibonacci!
  {fn [x] {if (< x 2) x (+ (fibonacci (- x 1)) (fibonacci (- x 2)))}})
