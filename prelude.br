op-do: {fn body
  {op: "call"
   args: [{op: "fn" args: (++ [{op: "list" args: []}] body)}
          {op: "list" args: []}]}}

inc: {fn [x] (+ x 1)}

merge: {fn [d0 d1] (merge-with {fn [a b] b} d0 d1)}

as-deref: {fn [name] {op: "deref" name: name}}
as-lit: {fn [val] {op: "lit" val: val}}

genname: {fn [x] (as-deref (gensym x))}

op-or: {fn [a b]
  a-name: (genname "a")
  {qq {do
        {uq a-name}: {as-result {uq a}}
        {if {uq a-name}.ok {uq a-name}.ok {uq b}}}}}

end-index: {fn [xs] (inc {or (last-index xs) -1})}

slice: {fn [xs start end]
  (++ [] (retain xs (range start end)))}

bind-op-++: {fn [coll rest]
  arg-name: (gensym "arg")
  {bind: arg-name
   ops: [
     {qq {uq coll}: {uq (as-deref arg-name)}}
     {qq {uq rest}: (slice {uq (as-deref arg-name)}
                           {uq (as-lit (end-index coll.args))}
                           (end-index {uq (as-deref arg-name)}))}]}}

bind-op-++<: {fn [rest coll]
  arg-name: (gensym "arg")
  {bind: arg-name
   ops: [
     {qq {uq rest}: (slice {uq (as-deref arg-name)}
                           0
                           (- (end-index {uq (as-deref arg-name)})
                              {uq (as-lit (end-index coll.args))}))}
     {qq {uq coll}: (slice {uq (as-deref arg-name)}
                           (- (end-index {uq (as-deref arg-name)})
                              {uq (as-lit (end-index coll.args))})
                           (end-index {uq (as-deref arg-name)}))}]}}

apply: {fn {++ [f] {++< xs [ys]}}
  {call f (++ xs ys)}}

mapf: {fn {++ [inner outer] xs}
  {fn ys
    (apply outer {call inner ys} xs)}}

map: {fn args
  (bake {call mapf args} args.0)}

kv-mapf: {fn {++ [inner outer] xs}
  {fn ys
    {call outer (++ ys [{call inner ys}] xs)}}}

kv-map: {fn args
  (bake {call kv-mapf args} args.0)}

zipf: {fn {++ [f] xs}
  {fn args
    {call f (map xs {fn [x] {call x args}})}}}

zip: {fn args
  (bake {call zipf args} args.1)}

[fibonacci define-fibonacci!]: (placeholder-fn)
(define-fibonacci!
  {fn [x] {if (< x 2) x (+ (fibonacci (- x 1)) (fibonacci (- x 2)))}})